extends SceneTree
func _initialize() -> void:
	_run.call_deferred()
func _run() -> void:
	var actor := Node3D.new()
	actor.set_meta("character_asset_family", "quaternius_animated_humanoid")
	actor.set_meta("source_forward_positive_z", true)
	root.add_child(actor)
	var skeleton := Skeleton3D.new()
	skeleton.name = "Skeleton3D"
	skeleton.add_bone("Head")
	actor.add_child(skeleton)
	var head := MeshInstance3D.new()
	head.name = "Head"
	head.mesh = BoxMesh.new()
	skeleton.add_child(head)
	var player := AnimationPlayer.new()
	actor.add_child(player)
	var library := AnimationLibrary.new()
	for name: String in ["Idle", "Death"]:
		var clip := Animation.new()
		clip.length = 1.0
		var track := clip.add_track(Animation.TYPE_ROTATION_3D)
		clip.track_set_path(track, NodePath("Skeleton3D:Head"))
		clip.rotation_track_insert_key(track, 0.0, Quaternion.IDENTITY)
		clip.rotation_track_insert_key(track, 1.0, Quaternion.IDENTITY)
		library.add_animation(name, clip)
	player.add_animation_library("", library)
	var driver := preload("res://scripts/character_animation_driver.gd").new()
	actor.add_child(driver)
	assert(driver.configure(actor,{"idle":"Idle", "death":"Death"}))
	driver.set_external_tick(true)
	var face := preload("res://scripts/character_face_driver.gd").new()
	actor.add_child(face)
	assert(face.configure(actor,"bandit_deserter"))
	var target := Node3D.new()
	root.add_child(target)
	target.position = Vector3(2,0,2)
	face.set_focus_target(target)
	driver.set_dead()
	driver.advance_external(1.1)
	face._on_update_timer_timeout()
	await create_timer(0.05).timeout
	var before := skeleton.get_bone_pose_rotation(0)
	face.head_modifier._process_modification()
	print("DEAD FACE REVIEW ",JSON.stringify({"driver_dead":driver.dead,"face_active":face.head_modifier.active,"face_timer_running":not face.update_timer.is_stopped(),"look_yaw":face.head_modifier.look_yaw,"current_yaw":face.head_modifier.current_yaw,"pose_changed":not before.is_equal_approx(skeleton.get_bone_pose_rotation(0))}))
	actor.free()
	target.free()
	quit()