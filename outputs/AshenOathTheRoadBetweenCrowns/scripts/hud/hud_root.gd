extends "res://scripts/hud/hud_api.gd"
## Composition and signal router; all view behavior belongs to injected panels.

var hud_lifecycle = preload("res://scripts/hud/hud_lifecycle.gd").new()
var dialogue_panel = preload("res://scripts/hud/dialogue_panel.gd").new()
var combat_feedback = preload("res://scripts/hud/combat_feedback.gd").new()
var menu_panel = preload("res://scripts/hud/menu_panel.gd").new()
var settings_panel = preload("res://scripts/hud/settings_panel.gd").new()
var quest_panel = preload("res://scripts/hud/quest_panel.gd").new()
var inventory_panel = preload("res://scripts/hud/inventory_panel.gd").new()
var hud_layout = preload("res://scripts/hud/hud_layout.gd").new()
var hud_input = preload("res://scripts/hud/hud_input.gd").new()
var save_panel = preload("res://scripts/hud/save_panel.gd").new()
var hud_style = preload("res://scripts/hud/hud_style.gd").new()

func _init() -> void:
	var signal_contract: Script = preload("res://scripts/hud/hud_component.gd")
	for component in [hud_lifecycle, dialogue_panel, combat_feedback, menu_panel, settings_panel, quest_panel, inventory_panel, hud_layout, hud_input, save_panel, hud_style]:
		component.configure(self, state)
		component.name = component.get_script().resource_path.get_file().get_basename().to_pascal_case()
		add_child(component)
		for request in signal_contract.get_script_signal_list():
			component.connect(request.name, Signal(self, request.name).emit)

