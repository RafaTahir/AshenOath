extends SceneTree
const Props = preload("res://scripts/held_prop_geometry.gd")
const Presentation = preload("res://scripts/character_presentation.gd")
const Arrow = preload("res://scripts/arrow_visual.gd")
func raw_glb(path: String) -> Node3D:
 var document := GLTFDocument.new()
 var state := GLTFState.new()
 assert(document.append_from_file(path,state) == OK)
 return document.generate_scene(state)
func _initialize() -> void:
 run.call_deferred()
func run() -> void:
 var stage := Node3D.new()
 root.add_child(stage)
 var staff := raw_glb("D:/Projects/AshenOath/outputs/AshenOathTheRoadBetweenCrowns/assets_external/design_pack_v1/C01_ash_staff.glb")
 stage.add_child(staff)
 var arrow := raw_glb("D:/Projects/AshenOath/outputs/AshenOathTheRoadBetweenCrowns/assets/characters/kael_arrow.glb")
 var anchor := Arrow.attach(stage,arrow)
 var ab: AABB = preload("res://scripts/character_role_contract.gd")._visible_bounds(arrow)
 assert(is_equal_approx(ab.size.z,.76))
 assert(ab.size.x < .05)
 var hammer = load("res://assets/characters/forge_hammer.tscn").instantiate()
 stage.add_child(hammer)
 assert(hammer.get_node("ForgedHead").mesh.get_surface_count() == 1)
 for style in ["bowl","bread","cloth","rope"]:
  var actor := Node3D.new()
  stage.add_child(actor)
  var skeleton := Skeleton3D.new()
  actor.add_child(skeleton)
  skeleton.add_bone("hand_r")
  assert(Presentation.attach_activity_tool(actor,style) != null)
 var player = load("res://scripts/player_controller.gd").new()
 var sword := Node3D.new()
 stage.add_child(sword)
 assert(player._attach_modeled_sword(sword,"oathblade"))
 var blade := sword.find_child("OathbladeSteel",true,false) as MeshInstance3D
 assert(blade != null and blade.material_override == null)
 assert(blade.get_active_material(0).albedo_color.is_equal_approx(Color(.65,.80,.82)))
 assert(is_zero_approx(blade.get_active_material(1).metallic))
 assert(blade.get_active_material(2).metallic > .70)
 assert(is_zero_approx(blade.get_active_material(3).metallic))
 assert(blade.get_active_material(3).roughness > .85)
 player.free()
 stage.queue_free()
 await process_frame
 print("EQUIPMENT_RESOURCE_OK: fresh GLBs, .76m actual arrow, hollow activity tools/quiver, hammer, separate cyan/metal/brass/leather sword slots")
 quit()
