{
  "scope": "New exact runtime utterances in this batch",
  "lines": [
    {
      "source_id": "conversation_topic:life2_nessa_carved_animals",
      "speaker_id": "player",
      "canonical_speaker": "kael",
      "text": "What do you make when you aren't baking?",
      "text_sha256": "ea59d114cf10b7a3915974c10c01c87e8cba1a8a9b73f6a30dc109e7cb915d25",
      "cast_role": "player",
      "direction": "Quiet, conversational; let the other person finish.",
      "required_new_or_recipe_changed": true,
      "directory": "living_cast"
    },
    {
      "source_id": "conversation_topic:life2_nessa_carved_animals",
      "speaker_id": "saga_nessa",
      "canonical_speaker": "nessa",
      "text": "Small animals from scrap wood. Rook says they are all potatoes with ears.",
      "text_sha256": "00da776f6d2d4a1d4e5958ca63accde4949ab388ccd57db71a5156559a8bca1d",
      "cast_role": "nessa",
      "direction": "Quiet, conversational; let the other person finish.",
      "required_new_or_recipe_changed": true,
      "directory": "living_cast"
    },
    {
      "source_id": "conversation_topic:life2_nessa_carved_animals",
      "speaker_id": "player",
      "canonical_speaker": "kael",
      "text": "Is he right?",
      "text_sha256": "72ad842092f38cbb4c2dae09e4f64d6e167c68fa1fcd52e0c2c97d0583ff228d",
      "cast_role": "player",
      "direction": "Quiet, conversational; let the other person finish.",
      "required_new_or_recipe_changed": true,
      "directory": "living_cast"
    },
    {
      "source_id": "conversation_topic:life2_nessa_carved_animals",
      "speaker_id": "saga_nessa",
      "canonical_speaker": "nessa",
      "text": "About the horse. The badger is very good. I refuse to hear otherwise.",
      "text_sha256": "afb1422c918db55d579a7248cf8e5f114221d8731b0f79328f6024874970aee2",
      "cast_role": "nessa",
      "direction": "Quiet, conversational; let the other person finish.",
      "required_new_or_recipe_changed": true,
      "directory": "living_cast"
    },
    {
      "source_id": "conversation_topic:life2_nessa_carved_animals",
      "speaker_id": "player",
      "canonical_speaker": "kael",
      "text": "Who gets them?",
      "text_sha256": "e274dbf0228159817c598745b23892ad6ad280088550ec56057d19aaf416d531",
      "cast_role": "player",
      "direction": "Quiet, conversational; let the other person finish.",
      "required_new_or_recipe_changed": true,
      "directory": "living_cast"
    },
    {
      "source_id": "conversation_topic:life2_nessa_carved_animals",
      "speaker_id": "saga_nessa",
      "canonical_speaker": "nessa",
      "text": "Whoever asks nicely. I keep the badger. An artist is allowed one satisfied customer.",
      "text_sha256": "7a2dfe5fae14ce3cde310904c0e211e7ba0005da8e255b366501186f9aa44722",
      "cast_role": "nessa",
      "direction": "Quiet, conversational; let the other person finish.",
      "required_new_or_recipe_changed": true,
      "directory": "living_cast"
    },
    {
      "source_id": "conversation_topic:life2_nessa_being_hosted",
      "speaker_id": "player",
      "canonical_speaker": "kael",
      "text": "Do you ever eat at someone else's table?",
      "text_sha256": "133c57ccf8438247091217aca9ec6b0ec7918fe999cc243951abed551d8ff549",
      "cast_role": "player",
      "direction": "Quiet, conversational; let the other person finish.",
      "required_new_or_recipe_changed": true,
      "directory": "living_cast"
    },
    {
      "source_id": "conversation_topic:life2_nessa_being_hosted",
      "speaker_id": "saga_nessa",
      "canonical_speaker": "nessa",
      "text": "I try. Then I see how they have stacked the bowls and start rearranging them.",
      "text_sha256": "659dca338fbabd7f54c0b73ff1a27c6d1f5a70c3c2673ad2aed8859660d577d5",
      "cast_role": "nessa",
      "direction": "Quiet, conversational; let the other person finish.",
      "required_new_or_recipe_changed": true,
      "directory": "living_cast"
    },
    {
      "source_id": "conversation_topic:life2_nessa_being_hosted",
      "speaker_id": "player",
      "canonical_speaker": "kael",
      "text": "What if they ask you to sit down?",
      "text_sha256": "8cab3adb22d97d306578e64eb35d87ac92e1bcd5d17ee5186bd7b0368385e32d",
      "cast_role": "player",
      "direction": "Quiet, conversational; let the other person finish.",
      "required_new_or_recipe_changed": true,
      "directory": "living_cast"
    },
    {
      "source_id": "conversation_topic:life2_nessa_being_hosted",
      "speaker_id": "saga_nessa",
      "canonical_speaker": "nessa",
      "text": "I sit. I notice the bowls from there as well.",
      "text_sha256": "49ce63e180ba5ab32abf423a4402286dc17e919102fec59a2cf2498a721b6bf9",
      "cast_role": "nessa",
      "direction": "Quiet, conversational; let the other person finish.",
      "required_new_or_recipe_changed": true,
      "directory": "living_cast"
    },
    {
      "source_id": "conversation_topic:life2_nessa_being_hosted",
      "speaker_id": "player",
      "canonical_speaker": "kael",
      "text": "Perhaps they want your company.",
      "text_sha256": "e05cf834e3503a5feb3b940fea6ca8c26853182d935f456e1a64b2ce9ccc6a47",
      "cast_role": "player",
      "direction": "Quiet, conversational; let the other person finish.",
      "required_new_or_recipe_changed": true,
      "directory": "living_cast"
    },
    {
      "source_id": "conversation_topic:life2_nessa_being_hosted",
      "speaker_id": "saga_nessa",
      "canonical_speaker": "nessa",
      "text": "That is what Elna said. Quite sharply, in fact. I had a lovely evening once I believed her.",
      "text_sha256": "4bd4d10e370c168d0b7d5afaef5b08701dd4dbf90106e5c6103355b3ec79dee9",
      "cast_role": "nessa",
      "direction": "Quiet, conversational; let the other person finish.",
      "required_new_or_recipe_changed": true,
      "directory": "living_cast"
    },
    {
      "source_id": "conversation_topic:life2_nera_next_place",
      "speaker_id": "player",
      "canonical_speaker": "kael",
      "text": "Where would you go with an empty cart?",
      "text_sha256": "ed1f071e2eee1449037d86a2693ee85dbd773ef65b6d8587055cb89b73975e9a",
      "cast_role": "player",
      "direction": "Quiet, conversational; let the other person finish.",
      "required_new_or_recipe_changed": true,
      "directory": "living_cast"
    },
    {
      "source_id": "conversation_topic:life2_nera_next_place",
      "speaker_id": "saga_nera",
      "canonical_speaker": "nera",
      "text": "Somewhere I had never been asked to take a cart. A difficult destination to put on a map.",
      "text_sha256": "b8568025628cd4d8f0b5c9324903ddb5e15af58694b551b776eba1d4f9dc0f6f",
      "cast_role": "nera",
      "direction": "Quiet, conversational; let the other person finish.",
      "required_new_or_recipe_changed": true,
      "directory": "living_cast"
    },
    {
      "source_id": "conversation_topic:life2_nera_next_place",
      "speaker_id": "player",
      "canonical_speaker": "kael",
      "text": "Sea or hills?",
      "text_sha256": "1ec53c2fde8cf57cdc100f2b1bac5c07aea16c8c0675563e40c9035024b67f4c",
      "cast_role": "player",
      "direction": "Quiet, conversational; let the other person finish.",
      "required_new_or_recipe_changed": true,
      "directory": "living_cast"
    },
    {
      "source_id": "conversation_topic:life2_nera_next_place",
      "speaker_id": "saga_nera",
      "canonical_speaker": "nera",
      "text": "Hills. I would like to reach the top and have nothing to unload.",
      "text_sha256": "561d38b7c1790dbc7e0a1822da5ad5ff03d071708d57fe901f4c09f3b5b4302e",
      "cast_role": "nera",
      "direction": "Quiet, conversational; let the other person finish.",
      "required_new_or_recipe_changed": true,
      "directory": "living_cast"
    },
    {
      "source_id": "conversation_topic:life2_nera_next_place",
      "speaker_id": "player",
      "canonical_speaker": "kael",
      "text": "Have you chosen a route?",
      "text_sha256": "3c1bfb92faa8667e5cb214a66b09cfff82ac9080f4bde6e75952e4649cae1816",
      "cast_role": "player",
      "direction": "Quiet, conversational; let the other person finish.",
      "required_new_or_recipe_changed": true,
      "directory": "living_cast"
    },
    {
      "source_id": "conversation_topic:life2_nera_next_place",
      "speaker_id": "saga_nera",
      "canonical_speaker": "nera",
      "text": "I'm keeping that part for myself a while. Planning it has been pleasant.",
      "text_sha256": "66299a39fea3b76a7ed90b8bcacb6124411619f99a75a62c6e154ebf4fb82ab3",
      "cast_role": "nera",
      "direction": "Quiet, conversational; let the other person finish.",
      "required_new_or_recipe_changed": true,
      "directory": "living_cast"
    },
    {
      "source_id": "conversation_topic:life2_nera_small_quarrel",
      "speaker_id": "player",
      "canonical_speaker": "kael",
      "text": "What do your crew argue about when the road is easy?",
      "text_sha256": "a2712940076a0272ef20e30ef4988d692685afc579fa69ac593209d08aed208d",
      "cast_role": "player",
      "direction": "Quiet, conversational; let the other person finish.",
      "required_new_or_recipe_changed": true,
      "directory": "living_cast"
    },
    {
      "source_id": "conversation_topic:life2_nera_small_quarrel",
      "speaker_id": "saga_nera",
      "canonical_speaker": "nera",
      "text": "Where to put a wet cup. It is an argument of surprising endurance.",
      "text_sha256": "88b15ae3828d841314e40942e1685efeaa39fa0d9a431df605a1306778193d30",
      "cast_role": "nera",
      "direction": "Quiet, conversational; let the other person finish.",
      "required_new_or_recipe_changed": true,
      "directory": "living_cast"
    },
    {
      "source_id": "conversation_topic:life2_nera_small_quarrel",
      "speaker_id": "player",
      "canonical_speaker": "kael",
      "text": "Where do you put yours?",
      "text_sha256": "d140d6a7e59baa085f853123e83d3a064d21614a8da3c45898f62f59ff2e6470",
      "cast_role": "player",
      "direction": "Quiet, conversational; let the other person finish.",
      "required_new_or_recipe_changed": true,
      "directory": "living_cast"
    },
    {
      "source_id": "conversation_topic:life2_nera_small_quarrel",
      "speaker_id": "saga_nera",
      "canonical_speaker": "nera",
      "text": "On top of whatever is least likely to fall. Apparently that is not a system.",
      "text_sha256": "1d16ba9e1d14f1244486721ef34859a7d69eb50d073fe7ac224c25d2960eb180",
      "cast_role": "nera",
      "direction": "Quiet, conversational; let the other person finish.",
      "required_new_or_recipe_changed": true,
      "directory": "living_cast"
    },
    {
      "source_id": "conversation_topic:life2_nera_small_quarrel",
      "speaker_id": "player",
      "canonical_speaker": "kael",
      "text": "Do you settle it as their leader?",
      "text_sha256": "f1b2240cb1ab4cab5656181a3fe0dfb1cc97611a0a4f04613b63bff8b9ad8e50",
      "cast_role": "player",
      "direction": "Quiet, conversational; let the other person finish.",
      "required_new_or_recipe_changed": true,
      "directory": "living_cast"
    },
    {
      "source_id": "conversation_topic:life2_nera_small_quarrel",
      "speaker_id": "saga_nera",
      "canonical_speaker": "nera",
      "text": "They have put a small cloth beside my seat. I have decided to regard it as a treaty.",
      "text_sha256": "af7654864393796b761e70b4ecde4b1de7cd4e9e87843e93385144e888751dbf",
      "cast_role": "nera",
      "direction": "Quiet, conversational; let the other person finish.",
      "required_new_or_recipe_changed": true,
      "directory": "living_cast"
    },
    {
      "source_id": "world_scene:gre_arrival",
      "speaker_id": "saga_nessa",
      "canonical_speaker": "nessa",
      "text": "Mind the hot side. A loaf looks much the same before it burns your hand.",
      "text_sha256": "3d16db7fb0fe7160d3581c0c0600cbb44f3f6abeca44df0a47a4249acf0a552b",
      "cast_role": "nessa",
      "direction": "everyday",
      "required_new_or_recipe_changed": true,
      "directory": "living_cast"
    },
    {
      "source_id": "world_scene:gre_arrival",
      "speaker_id": "saga_nessa",
      "canonical_speaker": "nessa",
      "text": "The one I told you to mind. There is water by the care bench, if Anwen needs a hand.",
      "text_sha256": "945b8867df1091ad233e591cc43ac0f906ed9e41688147060056d923fa7e6a2b",
      "cast_role": "nessa",
      "direction": "everyday",
      "required_new_or_recipe_changed": true,
      "directory": "living_cast"
    },
    {
      "source_id": "world_scene:gre_company",
      "speaker_id": "saga_nessa",
      "canonical_speaker": "nessa",
      "text": "The cups are identical.",
      "text_sha256": "eab1221edb4ff89ad46159a4f706523478d8dd90438a65c3c7dbf8681b0827cf",
      "cast_role": "nessa",
      "direction": "everyday",
      "required_new_or_recipe_changed": true,
      "directory": "living_cast"
    },
    {
      "source_id": "world_scene:dep_rebuild",
      "speaker_id": "mill_second_worker",
      "canonical_speaker": "nessa",
      "text": "And a finish to the shift?",
      "text_sha256": "86582c1261767194536cf6e6b8446a47086741d15c51a45ad0a208df51f5eb47",
      "cast_role": "nessa",
      "direction": "everyday",
      "required_new_or_recipe_changed": true,
      "directory": "living_cast"
    },
    {
      "source_id": "world_scene:dep_rebuild",
      "speaker_id": "mill_second_worker",
      "canonical_speaker": "nessa",
      "text": "These tools are for the new work, then.",
      "text_sha256": "2a2207243a55adb1022daa78b4fcf8ea3cf825bb051ca1ce5896485cfb650463",
      "cast_role": "nessa",
      "direction": "everyday",
      "required_new_or_recipe_changed": true,
      "directory": "living_cast"
    },
    {
      "source_id": "world_scene:roa_crossing",
      "speaker_id": "saga_nera",
      "canonical_speaker": "nera",
      "text": "Stand on the pale stone. Not because it is lucky. Because it is firm.",
      "text_sha256": "4418750238ba95713b348934856b97e4428b065b6d3d77729683af520de7b75a",
      "cast_role": "nera",
      "direction": "everyday",
      "required_new_or_recipe_changed": true,
      "directory": "living_cast"
    },
    {
      "source_id": "world_scene:roa_crossing",
      "speaker_id": "saga_nera",
      "canonical_speaker": "nera",
      "text": "Only the ones I want to reach the other side. So far, everyone.",
      "text_sha256": "a76397834e61728848e4d7ecc6925496271a795db994e71f6620813b35f13417",
      "cast_role": "nera",
      "direction": "everyday",
      "required_new_or_recipe_changed": true,
      "directory": "living_cast"
    },
    {
      "source_id": "world_scene:gre_exchange_before",
      "speaker_id": "saga_nessa",
      "canonical_speaker": "nessa",
      "text": "If that is another wager, carry the water first.",
      "text_sha256": "ac4f13d2e0ead370379da6a818d5084eaacfd0f56977d1bd47ff66c057839596",
      "cast_role": "nessa",
      "direction": "everyday",
      "required_new_or_recipe_changed": true,
      "directory": "living_cast"
    },
    {
      "source_id": "world_scene:gre_exchange_after",
      "speaker_id": "saga_nessa",
      "canonical_speaker": "nessa",
      "text": "The kettle stays here this time.",
      "text_sha256": "12df8d9c259bd24c0031d1f9d7155d9c6a517deeaed7745adbd0926db2462529",
      "cast_role": "nessa",
      "direction": "everyday",
      "required_new_or_recipe_changed": true,
      "directory": "living_cast"
    },
    {
      "source_id": "world_scene:dep_exchange_before",
      "speaker_id": "mill_second_worker",
      "canonical_speaker": "nessa",
      "text": "Your left or the wagon's?",
      "text_sha256": "ce1296353563c726d5ad9a6539957de4cab2b40fc043bb92d6c73fe650311bc3",
      "cast_role": "nessa",
      "direction": "everyday",
      "required_new_or_recipe_changed": true,
      "directory": "living_cast"
    },
    {
      "source_id": "world_scene:dep_exchange_after",
      "speaker_id": "mill_second_worker",
      "canonical_speaker": "nessa",
      "text": "No daylight through the cover.",
      "text_sha256": "e0880e29ae3016f59585c5ebd1996fd98361eee891cfd5e865e938461a7f3062",
      "cast_role": "nessa",
      "direction": "everyday",
      "required_new_or_recipe_changed": true,
      "directory": "living_cast"
    },
    {
      "source_id": "world_scene:escort_greyfen_arrival",
      "speaker_id": "saga_maren",
      "canonical_speaker": "nera",
      "text": "Heavy end down first. No, the other heavy end. They never put a light one on these carts.",
      "text_sha256": "032cf9cbe4c29a46ecd3f5c91660ba9e239196ba85da759366628ad553b7ce41",
      "cast_role": "nera",
      "direction": "everyday",
      "required_new_or_recipe_changed": true,
      "directory": "living_cast"
    },
    {
      "source_id": "world_scene:escort_greyfen_arrival",
      "speaker_id": "saga_maren",
      "canonical_speaker": "nera",
      "text": "With the wheel, yes. Not with finding advice. I have enough of that.",
      "text_sha256": "95943a87f8e9c4a47df7fd1f86d59a6f5f9d3936e66e46a301740825727f3050",
      "cast_role": "nera",
      "direction": "everyday",
      "required_new_or_recipe_changed": true,
      "directory": "living_cast"
    },
    {
      "source_id": "world_scene:escort_crossing_return",
      "speaker_id": "saga_nera",
      "canonical_speaker": "nera",
      "text": "Last one on firm ground. I counted people before crates this time too.",
      "text_sha256": "dbb59176a9f40f1698eb8828c47f5663583e262b167d702555c1ec0423761e62",
      "cast_role": "nera",
      "direction": "everyday",
      "required_new_or_recipe_changed": true,
      "directory": "living_cast"
    },
    {
      "source_id": "world_scene:escort_crossing_return",
      "speaker_id": "saga_nera",
      "canonical_speaker": "nera",
      "text": "You did. That was the job, and it is finished. Help me dry the rope before we discuss the next one.",
      "text_sha256": "33d752a5fb4f77e5431c2af71650289d6e1bc95cdde0a8cc591ecd06fb1aac6c",
      "cast_role": "nera",
      "direction": "everyday",
      "required_new_or_recipe_changed": true,
      "directory": "living_cast"
    },
    {
      "source_id": "world_scene:everyday_gre_pair",
      "speaker_id": "saga_nessa",
      "canonical_speaker": "nessa",
      "text": "You can count the shares. I'll cut them.",
      "text_sha256": "8dad1f5a422bf2dabdeba6a9a462670075a8f7ba6f967f63e1f3d7d25eeb49c4",
      "cast_role": "nessa",
      "direction": "everyday",
      "required_new_or_recipe_changed": true,
      "directory": "living_cast"
    },
    {
      "source_id": "world_scene:everyday_gre_pair",
      "speaker_id": "saga_nessa",
      "canonical_speaker": "nessa",
      "text": "From your thumb on the scale. Sit down, Rook. There is a share for you too.",
      "text_sha256": "59caacb475cba614aa8950ce486506d3dfc278ed1bf4926cef9ccc365b91dad4",
      "cast_role": "nessa",
      "direction": "everyday",
      "required_new_or_recipe_changed": true,
      "directory": "living_cast"
    },
    {
      "source_id": "world_scene:everyday_dep_pair",
      "speaker_id": "mill_second_worker",
      "canonical_speaker": "nessa",
      "text": "Then I can count what stays dry, not what the rain leaves me.",
      "text_sha256": "3b7e0f178f25c7fe62bdf420e34119b64738301a621ccb6db6bcd2353ec4a1ed",
      "cast_role": "nessa",
      "direction": "everyday",
      "required_new_or_recipe_changed": true,
      "directory": "living_cast"
    },
    {
      "source_id": "world_scene:everyday_var_pair_before",
      "speaker_id": "vargan_servant",
      "canonical_speaker": "nessa",
      "text": "The kitchen needs the answer before tomorrow, not a number to wait behind.",
      "text_sha256": "e3dc7f031ac09dfc7a04103d673d629a8eeb9b79986fbf73a1fe194a0616dbad",
      "cast_role": "nessa",
      "direction": "everyday",
      "required_new_or_recipe_changed": true,
      "directory": "living_cast"
    },
    {
      "source_id": "world_scene:everyday_var_pair_before",
      "speaker_id": "vargan_servant",
      "canonical_speaker": "nessa",
      "text": "Then put the hungry people on the page too.",
      "text_sha256": "73a96a09b14eef968bc33c70bbb257093e2f78851baec2290b7e881e6292a7d8",
      "cast_role": "nessa",
      "direction": "everyday",
      "required_new_or_recipe_changed": true,
      "directory": "living_cast"
    },
    {
      "source_id": "world_scene:everyday_var_pair_after",
      "speaker_id": "vargan_servant",
      "canonical_speaker": "nessa",
      "text": "I intend to. And I'll bring the empty bowls back before you close the book.",
      "text_sha256": "af6ea9ad948ac1077b0200ef3c52334ef32422549e566db9dba5104bee8f7cc9",
      "cast_role": "nessa",
      "direction": "everyday",
      "required_new_or_recipe_changed": true,
      "directory": "living_cast"
    },
    {
      "source_id": "world_scene:everyday_nessa_traveler_1",
      "speaker_id": "saga_nessa",
      "canonical_speaker": "nessa",
      "text": "I need a rack that doesn't leave the bottom sack in the wet.",
      "text_sha256": "a20ff3da4a992493e598983930a7e2931c832f072ba348a68b4f727ff8a89cc4",
      "cast_role": "nessa",
      "direction": "everyday",
      "required_new_or_recipe_changed": true,
      "directory": "living_cast"
    },
    {
      "source_id": "world_scene:everyday_nessa_traveler_1",
      "speaker_id": "saga_nessa",
      "canonical_speaker": "nessa",
      "text": "I have asked. He says the ground needs an opinion too.",
      "text_sha256": "8333c3af13ee1b8e2b655d0c315018057d292f0cfd3d508caa9834c3d14073a6",
      "cast_role": "nessa",
      "direction": "everyday",
      "required_new_or_recipe_changed": true,
      "directory": "living_cast"
    },
    {
      "source_id": "world_scene:everyday_nessa_traveler_2",
      "speaker_id": "mill_second_worker",
      "canonical_speaker": "nessa",
      "text": "We moved the sound boards off the damp. That much we can do today.",
      "text_sha256": "2e88d3554d4a7dc7a1d4d87616239198c8b65cb3bf92ac3cb153f90e4447e149",
      "cast_role": "nessa",
      "direction": "everyday",
      "required_new_or_recipe_changed": true,
      "directory": "living_cast"
    },
    {
      "source_id": "world_scene:everyday_nessa_traveler_2",
      "speaker_id": "mill_second_worker",
      "canonical_speaker": "nessa",
      "text": "Still work, not a promise you have to make for us.",
      "text_sha256": "bc75a0866dc7d00c8a7c23330978955bc6837e7991faa53b45b1a1c8e9a90153",
      "cast_role": "nessa",
      "direction": "everyday",
      "required_new_or_recipe_changed": true,
      "directory": "living_cast"
    },
    {
      "source_id": "world_scene:everyday_nessa_traveler_3",
      "speaker_id": "saga_nessa",
      "canonical_speaker": "nessa",
      "text": "The rebuilding account reached us. I can plan the next load around what is actually there.",
      "text_sha256": "0f0eaea4c9c3a6bd58c035f46bdb3fa0ac7fd2db74c85064cf81d06e4cf8303c",
      "cast_role": "nessa",
      "direction": "everyday",
      "required_new_or_recipe_changed": true,
      "directory": "living_cast"
    },
    {
      "source_id": "world_scene:everyday_nessa_traveler_3",
      "speaker_id": "saga_nessa",
      "canonical_speaker": "nessa",
      "text": "No. Something useful, with its costs written down.",
      "text_sha256": "63a96e6dd085474a405d1635976274ef75a26d5b466bc68ece6c7bc2b468efa5",
      "cast_role": "nessa",
      "direction": "everyday",
      "required_new_or_recipe_changed": true,
      "directory": "living_cast"
    },
    {
      "source_id": "world_scene:everyday_nera_outing",
      "speaker_id": "saga_nera",
      "canonical_speaker": "nera",
      "text": "Walk the dry approach with me. We check before anyone steps onto the crossing.",
      "text_sha256": "9718ea42059db917e5e083ca7d4538576c87deec40089e2bc0a68ec1bfc09901",
      "cast_role": "nera",
      "direction": "everyday",
      "required_new_or_recipe_changed": true,
      "directory": "living_cast"
    },
    {
      "source_id": "world_scene:everyday_nera_outing",
      "speaker_id": "saga_nera",
      "canonical_speaker": "nera",
      "text": "Feel for the loose turn. No load on it yet.",
      "text_sha256": "acb844d3e6878ed2788c7045b02c47dbb03c75100b3d2a25b3a7852bdb798fa2",
      "cast_role": "nera",
      "direction": "everyday",
      "required_new_or_recipe_changed": true,
      "directory": "living_cast"
    },
    {
      "source_id": "world_scene:everyday_nera_outing",
      "speaker_id": "saga_nera",
      "canonical_speaker": "nera",
      "text": "Good. Now it is a checked rope, not a brave prediction.",
      "text_sha256": "22dbe6d6ad44d1bad6e995eb37cd9788b7b9025099efa62d090699bf59fbb472",
      "cast_role": "nera",
      "direction": "everyday",
      "required_new_or_recipe_changed": true,
      "directory": "living_cast"
    },
    {
      "source_id": "world_scene:everyday_performance_table",
      "speaker_id": "saga_nessa",
      "canonical_speaker": "nessa",
      "text": "The tune can finish before the washing starts.",
      "text_sha256": "011ae9c7c51658af3865c3d2748c0852a40412c3f6e36fb957b2b53902a46708",
      "cast_role": "nessa",
      "direction": "everyday",
      "required_new_or_recipe_changed": true,
      "directory": "living_cast"
    },
    {
      "source_id": "world_scene:everyday_performance_table",
      "speaker_id": "saga_nessa",
      "canonical_speaker": "nessa",
      "text": "I haven't mentioned the second bucket.",
      "text_sha256": "341967d4c997def3eb53d16d0a4986ebc1ba41eb176086f8bf98b521c6f40d1a",
      "cast_role": "nessa",
      "direction": "everyday",
      "required_new_or_recipe_changed": true,
      "directory": "living_cast"
    },
    {
      "source_id": "world_scene:life2_anwen_take_a_breath",
      "speaker_id": "sister_anwen",
      "canonical_speaker": "anwen",
      "text": "I was about to find another job. You caught me.",
      "text_sha256": "82e8bd3c6e1abf7bd6a87fa363283fea1bede06718f0e1fb696fe9923928a231",
      "cast_role": "sister_anwen",
      "direction": "everyday",
      "required_new_or_recipe_changed": true,
      "directory": "living_cast"
    },
    {
      "source_id": "world_scene:life2_anwen_take_a_breath",
      "speaker_id": "player",
      "canonical_speaker": "kael",
      "text": "I can leave if you want the quiet.",
      "text_sha256": "180a02cac08829b7309fa9ec2b9a22b0f654376220b4e0509bb8d36c700a258f",
      "cast_role": "player",
      "direction": "everyday",
      "required_new_or_recipe_changed": true,
      "directory": "living_cast"
    },
    {
      "source_id": "world_scene:life2_anwen_take_a_breath",
      "speaker_id": "sister_anwen",
      "canonical_speaker": "anwen",
      "text": "Stay. Tell me the least important thing you saw on the road.",
      "text_sha256": "daf99773de8134929875cb429788a27b226dcd0fa18bc420ea401d90b56cdc5b",
      "cast_role": "sister_anwen",
      "direction": "everyday",
      "required_new_or_recipe_changed": true,
      "directory": "living_cast"
    },
    {
      "source_id": "world_scene:life2_anwen_take_a_breath",
      "speaker_id": "player",
      "canonical_speaker": "kael",
      "text": "A crow trying to carry a twig through a gap too narrow for it.",
      "text_sha256": "ce2fe3ead6c22e549714990d1f95213961c19b5912f91436c5a5d11eced77cab",
      "cast_role": "player",
      "direction": "everyday",
      "required_new_or_recipe_changed": true,
      "directory": "living_cast"
    },
    {
      "source_id": "world_scene:life2_anwen_take_a_breath",
      "speaker_id": "sister_anwen",
      "canonical_speaker": "anwen",
      "text": "Did it turn the twig?",
      "text_sha256": "59ba98b295a84f05f3c6df4e40af4da8fa45b70e889bbff1364b3a68c39dde06",
      "cast_role": "sister_anwen",
      "direction": "everyday",
      "required_new_or_recipe_changed": true,
      "directory": "living_cast"
    },
    {
      "source_id": "world_scene:life2_anwen_take_a_breath",
      "speaker_id": "player",
      "canonical_speaker": "kael",
      "text": "Eventually. It seemed annoyed that this worked.",
      "text_sha256": "a9a89aea48aa524e934e09bf85925dc96f7fc6225bcb96a9231b9dd06d3abfd9",
      "cast_role": "player",
      "direction": "everyday",
      "required_new_or_recipe_changed": true,
      "directory": "living_cast"
    },
    {
      "source_id": "world_scene:life2_rook_lost_word",
      "speaker_id": "rook",
      "canonical_speaker": "rook",
      "text": "There was a splendid ending to this story. I put it somewhere between the second inn and the third.",
      "text_sha256": "695a8a8a142fb4d88a26148318734a6a16372754d6dadfbaff9cf386a385e89a",
      "cast_role": "rook",
      "direction": "everyday",
      "required_new_or_recipe_changed": true,
      "directory": "living_cast"
    },
    {
      "source_id": "world_scene:life2_rook_lost_word",
      "speaker_id": "player",
      "canonical_speaker": "kael",
      "text": "Start with the ending you have.",
      "text_sha256": "8077e6e1a5dd7e5598d34d413454b7e1524e4bf53ffff42472e66aa1e4a5b029",
      "cast_role": "player",
      "direction": "everyday",
      "required_new_or_recipe_changed": true,
      "directory": "living_cast"
    },
    {
      "source_id": "world_scene:life2_rook_lost_word",
      "speaker_id": "rook",
      "canonical_speaker": "rook",
      "text": "A man bought a hat. No, the hat was important earlier.",
      "text_sha256": "56b12d13663fed4e0c6c979054e77ca81b729ea82fddef4e097ac71b815e7511",
      "cast_role": "rook",
      "direction": "everyday",
      "required_new_or_recipe_changed": true,
      "directory": "living_cast"
    },
    {
      "source_id": "world_scene:life2_rook_lost_word",
      "speaker_id": "player",
      "canonical_speaker": "kael",
      "text": "Perhaps he was pleased with it.",
      "text_sha256": "10857e7b4b33d8d06390a52ac12c3017c42cbdb65bd35e1daee985c4f478657f",
      "cast_role": "player",
      "direction": "everyday",
      "required_new_or_recipe_changed": true,
      "directory": "living_cast"
    },
    {
      "source_id": "world_scene:life2_rook_lost_word",
      "speaker_id": "rook",
      "canonical_speaker": "rook",
      "text": "You have reduced a triumph of storytelling to a satisfactory purchase.",
      "text_sha256": "e5149f22d3b1c8060b38f671d371054400be5caa4410cb59c024d2fbe0d99a8d",
      "cast_role": "rook",
      "direction": "everyday",
      "required_new_or_recipe_changed": true,
      "directory": "living_cast"
    },
    {
      "source_id": "world_scene:life2_rook_lost_word",
      "speaker_id": "player",
      "canonical_speaker": "kael",
      "text": "I am pleased for him.",
      "text_sha256": "d609574c687b59d4e577d019a13f03aca251e60b24be8806449aabd4ecfa859f",
      "cast_role": "player",
      "direction": "everyday",
      "required_new_or_recipe_changed": true,
      "directory": "living_cast"
    },
    {
      "source_id": "world_scene:life2_mira_good_color",
      "speaker_id": "mira",
      "canonical_speaker": "mira",
      "text": "Yellow, I think. I am allowed to change my mind before you answer.",
      "text_sha256": "689103a08ba8a25390f5050e8bf0a8259c1c626b3b5900c1fe0b962407a32625",
      "cast_role": "mira",
      "direction": "everyday",
      "required_new_or_recipe_changed": true,
      "directory": "living_cast"
    },
    {
      "source_id": "world_scene:life2_mira_good_color",
      "speaker_id": "player",
      "canonical_speaker": "kael",
      "text": "What are we choosing?",
      "text_sha256": "742b32f67a9f171838214f630efbb7aea5fa2c331dab4d0a2826f11dd399273d",
      "cast_role": "player",
      "direction": "everyday",
      "required_new_or_recipe_changed": true,
      "directory": "living_cast"
    },
    {
      "source_id": "world_scene:life2_mira_good_color",
      "speaker_id": "mira",
      "canonical_speaker": "mira",
      "text": "The color I would paint a door if I had a free afternoon.",
      "text_sha256": "3a162f1f5c6ae70d5f737687c7765ce5fbc4ca3ab4bf806b41207c1d9a69a206",
      "cast_role": "mira",
      "direction": "everyday",
      "required_new_or_recipe_changed": true,
      "directory": "living_cast"
    },
    {
      "source_id": "world_scene:life2_mira_good_color",
      "speaker_id": "player",
      "canonical_speaker": "kael",
      "text": "Yellow would be easy to find in the rain.",
      "text_sha256": "c2331b54bea3b0cd2117600dfda1fd53150de0544a0b9624e54da2be65f0b873",
      "cast_role": "player",
      "direction": "everyday",
      "required_new_or_recipe_changed": true,
      "directory": "living_cast"
    },
    {
      "source_id": "world_scene:life2_mira_good_color",
      "speaker_id": "mira",
      "canonical_speaker": "mira",
      "text": "That is useful, but I was enjoying how cheerful it would look.",
      "text_sha256": "e245d3547a5641d92d2875fd4f0abe8a204690590ec88f8ec1bc974f2a67bab4",
      "cast_role": "mira",
      "direction": "everyday",
      "required_new_or_recipe_changed": true,
      "directory": "living_cast"
    },
    {
      "source_id": "world_scene:life2_mira_good_color",
      "speaker_id": "player",
      "canonical_speaker": "kael",
      "text": "Then yellow. Cheerful first.",
      "text_sha256": "bab2f55e32550770a9e1c6d50f9841d3cf7b3176b4b56731c8ecd63401e43131",
      "cast_role": "player",
      "direction": "everyday",
      "required_new_or_recipe_changed": true,
      "directory": "living_cast"
    },
    {
      "source_id": "world_scene:life2_tor_hands_behind_back",
      "speaker_id": "blacksmith_tor",
      "canonical_speaker": "tor",
      "text": "Tell me where you would put your thumb. I'll keep my hands here.",
      "text_sha256": "719d7bca150cc201e1189cbb960ac1836073dd3f75d82380e54e88abe63638d9",
      "cast_role": "tor",
      "direction": "everyday",
      "required_new_or_recipe_changed": true,
      "directory": "living_cast"
    },
    {
      "source_id": "world_scene:life2_tor_hands_behind_back",
      "speaker_id": "player",
      "canonical_speaker": "kael",
      "text": "Away from the head of the tool.",
      "text_sha256": "f567875ee63c613650f7f4c52b9caf1adf4e05b996416048a8117611b1acfcb6",
      "cast_role": "player",
      "direction": "everyday",
      "required_new_or_recipe_changed": true,
      "directory": "living_cast"
    },
    {
      "source_id": "world_scene:life2_tor_hands_behind_back",
      "speaker_id": "blacksmith_tor",
      "canonical_speaker": "tor",
      "text": "Good. And your other hand?",
      "text_sha256": "4a8654ff466227441266643f429eded668fe923add625e5e9987383cd171098d",
      "cast_role": "tor",
      "direction": "everyday",
      "required_new_or_recipe_changed": true,
      "directory": "living_cast"
    },
    {
      "source_id": "world_scene:life2_tor_hands_behind_back",
      "speaker_id": "player",
      "canonical_speaker": "kael",
      "text": "Clear of where it comes down.",
      "text_sha256": "06bdc8a96701ca712eb14b8a758a0d0bd85e3a2e5c1d1def8f125fa950b7fa70",
      "cast_role": "player",
      "direction": "everyday",
      "required_new_or_recipe_changed": true,
      "directory": "living_cast"
    },
    {
      "source_id": "world_scene:life2_tor_hands_behind_back",
      "speaker_id": "blacksmith_tor",
      "canonical_speaker": "tor",
      "text": "There. I managed an entire lesson without grabbing anything.",
      "text_sha256": "d2cd80ca67613709aba5f85d7b1a49efe9dd8cc65154b8100f68a0b36cab5ba2",
      "cast_role": "tor",
      "direction": "everyday",
      "required_new_or_recipe_changed": true,
      "directory": "living_cast"
    },
    {
      "source_id": "world_scene:life2_tor_hands_behind_back",
      "speaker_id": "player",
      "canonical_speaker": "kael",
      "text": "You moved your elbow twice.",
      "text_sha256": "406cd70852373c470dd77502644301ab87bfe5c0f2f803a0b377910e45930ed3",
      "cast_role": "player",
      "direction": "everyday",
      "required_new_or_recipe_changed": true,
      "directory": "living_cast"
    },
    {
      "source_id": "world_scene:life2_elna_ordinary_question",
      "speaker_id": "widow_elna",
      "canonical_speaker": "elna",
      "text": "Go on. You have the expression you get before a careful question.",
      "text_sha256": "bb067dae49daa6ad75e7419a9369550ef0ad72ec54b6fd8dd130c662d5d4771f",
      "cast_role": "elna",
      "direction": "everyday",
      "required_new_or_recipe_changed": true,
      "directory": "living_cast"
    },
    {
      "source_id": "world_scene:life2_elna_ordinary_question",
      "speaker_id": "player",
      "canonical_speaker": "kael",
      "text": "Would you rather have a sunny room or a cool one?",
      "text_sha256": "3e246df4ace607c44892fd61c6a6943de92ba629c1958e3d2de0aafe0f84aa9d",
      "cast_role": "player",
      "direction": "everyday",
      "required_new_or_recipe_changed": true,
      "directory": "living_cast"
    },
    {
      "source_id": "world_scene:life2_elna_ordinary_question",
      "speaker_id": "widow_elna",
      "canonical_speaker": "elna",
      "text": "Sunny. I can always open a window. That was a good question.",
      "text_sha256": "35c224615e46a7b1657188e9ad2d3ae6e51a43af0950af789f74b2d49c5ef49d",
      "cast_role": "elna",
      "direction": "everyday",
      "required_new_or_recipe_changed": true,
      "directory": "living_cast"
    },
    {
      "source_id": "world_scene:life2_elna_ordinary_question",
      "speaker_id": "player",
      "canonical_speaker": "kael",
      "text": "I had two more prepared.",
      "text_sha256": "65513bbb4e757fc6b0146c100d0fd6e3db0a92cd2753e381128d43eafd81fd6d",
      "cast_role": "player",
      "direction": "everyday",
      "required_new_or_recipe_changed": true,
      "directory": "living_cast"
    },
    {
      "source_id": "world_scene:life2_elna_ordinary_question",
      "speaker_id": "widow_elna",
      "canonical_speaker": "elna",
      "text": "Save them. We can manage a conversation without provisions for the whole week.",
      "text_sha256": "640b6cbdbe350a3befbb4b31bd63570da1c25a740d2ae532b1befc291b577587",
      "cast_role": "elna",
      "direction": "everyday",
      "required_new_or_recipe_changed": true,
      "directory": "living_cast"
    },
    {
      "source_id": "world_scene:life2_elna_ordinary_question",
      "speaker_id": "player",
      "canonical_speaker": "kael",
      "text": "Sunny, then.",
      "text_sha256": "a164b25a55c4da90b5d425d052680ac895e97302a4a643f81130d263df85ee97",
      "cast_role": "player",
      "direction": "everyday",
      "required_new_or_recipe_changed": true,
      "directory": "living_cast"
    },
    {
      "source_id": "world_scene:life2_toma_unanswered_weather",
      "speaker_id": "farmer_toma",
      "canonical_speaker": "toma",
      "text": "Do you think it will rain before morning?",
      "text_sha256": "ad0556791f92c562f8dbcc7c98a578975faf36faea9b5cd6414a1ebaa2c4d645",
      "cast_role": "toma",
      "direction": "everyday",
      "required_new_or_recipe_changed": true,
      "directory": "living_cast"
    },
    {
      "source_id": "world_scene:life2_toma_unanswered_weather",
      "speaker_id": "player",
      "canonical_speaker": "kael",
      "text": "I was going to ask you.",
      "text_sha256": "d008eb2fafffa3719e9430345c28ca0544622c5d98efde87453188c1d692e9b8",
      "cast_role": "player",
      "direction": "everyday",
      "required_new_or_recipe_changed": true,
      "directory": "living_cast"
    },
    {
      "source_id": "world_scene:life2_toma_unanswered_weather",
      "speaker_id": "farmer_toma",
      "canonical_speaker": "toma",
      "text": "That is inconvenient. I had hoped to borrow your certainty.",
      "text_sha256": "4f94e9484ced789d0404a1a9d89c6223d293f44ec3f9bf3cf9a11c29aeb04d66",
      "cast_role": "toma",
      "direction": "everyday",
      "required_new_or_recipe_changed": true,
      "directory": "living_cast"
    },
    {
      "source_id": "world_scene:life2_toma_unanswered_weather",
      "speaker_id": "player",
      "canonical_speaker": "kael",
      "text": "We could look again before we leave.",
      "text_sha256": "769db3825d95fac15e129ca81d25e56da15e0d983fe33dbbe94805500751fdd3",
      "cast_role": "player",
      "direction": "everyday",
      "required_new_or_recipe_changed": true,
      "directory": "living_cast"
    },
    {
      "source_id": "world_scene:life2_toma_unanswered_weather",
      "speaker_id": "farmer_toma",
      "canonical_speaker": "toma",
      "text": "Or admit we don't know and get indoors while it is dry.",
      "text_sha256": "a5340792cf67ec5b14ca933a51c8fdc773153c56b53f72f2d944033f0bd98f63",
      "cast_role": "toma",
