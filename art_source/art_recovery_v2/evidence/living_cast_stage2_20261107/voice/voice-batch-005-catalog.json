{
  "scope": "Batch005 newly delivered exact runtime utterances only; full catalog remains incomplete",
  "lines": [
    {
      "source_id": "community:consent:vale:no",
      "speaker_id": "vargan_record_keeper",
      "canonical_speaker": "vale",
      "text": "I can finish these shelves. I cannot become their permanent keeper.",
      "text_sha256": "d4eacfd11e04950bfafd327563c1cea12ae7c1a7f28d4cec2437af67be980cb0",
      "cast_role": "vale",
      "direction": "",
      "required_new_or_recipe_changed": true,
      "directory": "community"
    },
    {
      "source_id": "community:consent:vale:withdraw",
      "speaker_id": "vargan_record_keeper",
      "canonical_speaker": "vale",
      "text": "I am leaving this copy with the agreed custodian. The sealed accounts remain under their owners' terms.",
      "text_sha256": "23441d5981064aa2ae069873c76739be8d1c124b402bb798be8a3561c1348464",
      "cast_role": "vale",
      "direction": "",
      "required_new_or_recipe_changed": true,
      "directory": "community"
    },
    {
      "source_id": "community:consent:vale:question",
      "speaker_id": "player",
      "canonical_speaker": "kael",
      "text": "Will you keep a copy without claiming its people's choices?",
      "text_sha256": "a40fbfed2cf6d4b0ea24efe5e498a6c694f69c0eca02ac1d41ecf862b25c1664",
      "cast_role": "player",
      "direction": "",
      "required_new_or_recipe_changed": true,
      "directory": "community"
    },
    {
      "source_id": "community:consent:merrow:yes",
      "speaker_id": "vargan_steward",
      "canonical_speaker": "merrow",
      "text": "A weekly comparison and an open handover. If I withdraw, the book will show the vacancy. I will not fill it with an order.",
      "text_sha256": "67506ed3a10d27fdc226a6658ef6a122da74068823f8e7765a0466b4d5fa9d5f",
      "cast_role": "merrow",
      "direction": "",
      "required_new_or_recipe_changed": true,
      "directory": "community"
    },
    {
      "source_id": "community:consent:merrow:no",
      "speaker_id": "vargan_steward",
      "canonical_speaker": "merrow",
      "text": "I owe you an account of what I administered. That debt is not a promise to take this office.",
      "text_sha256": "a827b1d13ef471549a8493902dc20c1086f9a26a16ed22ace760023411114ce4",
      "cast_role": "merrow",
      "direction": "",
      "required_new_or_recipe_changed": true,
      "directory": "community"
    },
    {
      "source_id": "community:consent:merrow:withdraw",
      "speaker_id": "vargan_steward",
      "canonical_speaker": "merrow",
      "text": "Mark my shift vacant. The records stay available, and the reasons for my old orders stay in them.",
      "text_sha256": "f6bd635159dc6fba839b67d4c1c00db830fac8370b8f71a2a25caa761c720ec8",
      "cast_role": "merrow",
      "direction": "",
      "required_new_or_recipe_changed": true,
      "directory": "community"
    },
    {
      "source_id": "community:consent:merrow:question",
      "speaker_id": "player",
      "canonical_speaker": "kael",
      "text": "Will you take a record shift with a public handover?",
      "text_sha256": "07cd9f1d888e06a91394f239cd01b5bda74ff7a87518f84600d3401cf2c2b6f5",
      "cast_role": "player",
      "direction": "",
      "required_new_or_recipe_changed": true,
      "directory": "community"
    },
    {
      "source_id": "community:departure:anwen:yes",
      "speaker_id": "sister_anwen",
      "canonical_speaker": "anwen",
      "text": "I will move to the refuge. The shrine's record comes with me; the old stones do not.",
      "text_sha256": "c182962bdb07b28aa4830592055c4252dbf9db9795486ae536d5117bf7137ebb",
      "cast_role": "sister_anwen",
      "direction": "",
      "required_new_or_recipe_changed": true,
      "directory": "community"
    },
    {
      "source_id": "community:departure:anwen:no",
      "speaker_id": "sister_anwen",
      "canonical_speaker": "anwen",
      "text": "I will remain with the people who stay. Do not put my name on the departure list.",
      "text_sha256": "7e00c5cb5e9b26d4d6ef0130a7d773e0222012ed8849ef8f2ca30ed4f4314559",
      "cast_role": "sister_anwen",
      "direction": "",
      "required_new_or_recipe_changed": true,
      "directory": "community"
    },
    {
      "source_id": "community:departure:anwen:withdraw",
      "speaker_id": "sister_anwen",
      "canonical_speaker": "anwen",
      "text": "Take my name off the departure list. I am not agreeing to move.",
      "text_sha256": "ce5b833a6ebe09b7140369d5a670594c0dc7aed4b1f0a4fccd1c1dd3592eb6ab",
      "cast_role": "sister_anwen",
      "direction": "",
      "required_new_or_recipe_changed": true,
      "directory": "community"
    },
    {
      "source_id": "community:departure:anwen:question",
      "speaker_id": "player",
      "canonical_speaker": "kael",
      "text": "If the old shelter is dismantled, do you want to make Hearthward your home?",
      "text_sha256": "b2807687585afa47b54a602c7845dec122e47367a2df74f67a677fd3aaf5c656",
      "cast_role": "player",
      "direction": "",
      "required_new_or_recipe_changed": true,
      "directory": "community"
    },
    {
      "source_id": "community:departure:mira:yes",
      "speaker_id": "mira",
      "canonical_speaker": "mira",
      "text": "I will take my own practice to Hearthward. My patients decide for themselves where they go.",
      "text_sha256": "7f24be69aa4672189538d77d9de55198a9f05ae3b6e348d1fc6b3414f6750b65",
      "cast_role": "mira",
      "direction": "",
      "required_new_or_recipe_changed": true,
      "directory": "community"
    },
    {
      "source_id": "community:departure:mira:no",
      "speaker_id": "mira",
      "canonical_speaker": "mira",
      "text": "I will keep treating people here. Their need for care is not permission to move them.",
      "text_sha256": "2c5d042817f8b600b0ed3052f368989ff94ee3bdc2927498423f9f419c854bf5",
      "cast_role": "mira",
      "direction": "",
      "required_new_or_recipe_changed": true,
      "directory": "community"
    },
    {
      "source_id": "community:departure:mira:withdraw",
      "speaker_id": "mira",
      "canonical_speaker": "mira",
      "text": "Take my name off the departure list. I am not agreeing to move.",
      "text_sha256": "ce5b833a6ebe09b7140369d5a670594c0dc7aed4b1f0a4fccd1c1dd3592eb6ab",
      "cast_role": "mira",
      "direction": "",
      "required_new_or_recipe_changed": true,
      "directory": "community"
    },
    {
      "source_id": "community:departure:mira:question",
      "speaker_id": "player",
      "canonical_speaker": "kael",
      "text": "If the old shelter is dismantled, do you want to make Hearthward your home?",
      "text_sha256": "b2807687585afa47b54a602c7845dec122e47367a2df74f67a677fd3aaf5c656",
      "cast_role": "player",
      "direction": "",
      "required_new_or_recipe_changed": true,
      "directory": "community"
    },
    {
      "source_id": "community:departure:vale:yes",
      "speaker_id": "vargan_record_keeper",
      "canonical_speaker": "vale",
      "text": "I choose Hearthward. The copies need a dry place, and I want to live beyond this archive.",
      "text_sha256": "aebdfae9597eafa66c2e78511cb4f349a8e90aaeb29035f60b8937c373f35590",
      "cast_role": "vale",
      "direction": "",
      "required_new_or_recipe_changed": true,
      "directory": "community"
    },
    {
      "source_id": "community:departure:vale:no",
      "speaker_id": "vargan_record_keeper",
      "canonical_speaker": "vale",
      "text": "I will stay with the archive. You can carry the agreed copies without claiming that I have left.",
      "text_sha256": "4c90d1b92d2d41eb5b3cb69dbb2acfe1e0eafc035840991852a569d3dced30e2",
      "cast_role": "vale",
      "direction": "",
      "required_new_or_recipe_changed": true,
      "directory": "community"
    },
    {
      "source_id": "community:departure:vale:withdraw",
      "speaker_id": "vargan_record_keeper",
      "canonical_speaker": "vale",
      "text": "Take my name off the departure list. I am not agreeing to move.",
      "text_sha256": "ce5b833a6ebe09b7140369d5a670594c0dc7aed4b1f0a4fccd1c1dd3592eb6ab",
      "cast_role": "vale",
      "direction": "",
      "required_new_or_recipe_changed": true,
      "directory": "community"
    },
    {
      "source_id": "community:departure:vale:question",
      "speaker_id": "player",
      "canonical_speaker": "kael",
      "text": "If the old shelter is dismantled, do you want to make Hearthward your home?",
      "text_sha256": "b2807687585afa47b54a602c7845dec122e47367a2df74f67a677fd3aaf5c656",
      "cast_role": "player",
      "direction": "",
      "required_new_or_recipe_changed": true,
      "directory": "community"
    },
    {
      "source_id": "community:departure:merrow:yes",
      "speaker_id": "vargan_steward",
      "canonical_speaker": "merrow",
      "text": "I will move and keep the refuge's accounts. That is my answer, not an order for the staff.",
      "text_sha256": "49430f590e463ffe0e90e0ede22dd2f28d06111509b0d7ebb9b8c01c22365d70",
      "cast_role": "merrow",
      "direction": "",
      "required_new_or_recipe_changed": true,
      "directory": "community"
    },
    {
      "source_id": "community:departure:merrow:no",
      "speaker_id": "vargan_steward",
      "canonical_speaker": "merrow",
      "text": "I will stay to account for what remains. Record the households who leave without adding me.",
      "text_sha256": "d92a13cb8b8a2c5ab0d728361cc12c204fa01d7f9b7fa5dd5ffe4c0269445eda",
      "cast_role": "merrow",
      "direction": "",
      "required_new_or_recipe_changed": true,
      "directory": "community"
    },
    {
      "source_id": "community:departure:merrow:withdraw",
      "speaker_id": "vargan_steward",
      "canonical_speaker": "merrow",
      "text": "Take my name off the departure list. I am not agreeing to move.",
      "text_sha256": "ce5b833a6ebe09b7140369d5a670594c0dc7aed4b1f0a4fccd1c1dd3592eb6ab",
      "cast_role": "merrow",
      "direction": "",
      "required_new_or_recipe_changed": true,
      "directory": "community"
    },
    {
      "source_id": "community:departure:merrow:question",
      "speaker_id": "player",
      "canonical_speaker": "kael",
      "text": "If the old shelter is dismantled, do you want to make Hearthward your home?",
      "text_sha256": "b2807687585afa47b54a602c7845dec122e47367a2df74f67a677fd3aaf5c656",
      "cast_role": "player",
      "direction": "",
      "required_new_or_recipe_changed": true,
      "directory": "community"
    },
    {
      "source_id": "community:departure:nessa:yes",
      "speaker_id": "saga_nessa",
      "canonical_speaker": "nessa",
      "text": "I choose the refuge. I can take my pots and begin another kitchen.",
      "text_sha256": "94c5f2e3e56e51859424b1bdef91f0d444132a4ec6e7bab9262ccf4e3d9c1add",
      "cast_role": "nessa",
      "direction": "",
      "required_new_or_recipe_changed": true,
      "directory": "community"
    },
    {
      "source_id": "community:departure:nessa:no",
      "speaker_id": "saga_nessa",
      "canonical_speaker": "nessa",
      "text": "I will keep a kitchen for the people who remain. A meal here will not require their promise to stay.",
      "text_sha256": "2652fcabf1cbdad21fe44b6b7fd35e1bffa90b60ea33b87d08d1bd56388e1724",
      "cast_role": "nessa",
      "direction": "",
      "required_new_or_recipe_changed": true,
      "directory": "community"
    },
    {
      "source_id": "community:departure:nessa:withdraw",
      "speaker_id": "saga_nessa",
      "canonical_speaker": "nessa",
      "text": "Take my name off the departure list. I am not agreeing to move.",
      "text_sha256": "ce5b833a6ebe09b7140369d5a670594c0dc7aed4b1f0a4fccd1c1dd3592eb6ab",
      "cast_role": "nessa",
      "direction": "",
      "required_new_or_recipe_changed": true,
      "directory": "community"
    },
    {
      "source_id": "community:departure:nessa:question",
      "speaker_id": "player",
      "canonical_speaker": "kael",
      "text": "If the old shelter is dismantled, do you want to make Hearthward your home?",
      "text_sha256": "b2807687585afa47b54a602c7845dec122e47367a2df74f67a677fd3aaf5c656",
      "cast_role": "player",
      "direction": "",
      "required_new_or_recipe_changed": true,
      "directory": "community"
    },
    {
      "source_id": "community:departure:nera:yes",
      "speaker_id": "saga_nera",
      "canonical_speaker": "nera",
      "text": "I will make Hearthward my next home. I am choosing this road now; the abandoned escort is still on the record.",
      "text_sha256": "dbbb8be1017017fdac680c9c1b3a1f2fb9314ae1461069d9b5b53886df234b38",
      "cast_role": "nera",
      "direction": "",
      "required_new_or_recipe_changed": true,
      "directory": "community"
    },
    {
      "source_id": "community:departure:nera:no",
      "speaker_id": "saga_nera",
      "canonical_speaker": "nera",
      "text": "I will lead my own next journey. The households' passage does not appoint me to follow them.",
      "text_sha256": "360507903b49f03be0d945a130206015a12416367133df679261a7ccc205fc38",
      "cast_role": "nera",
      "direction": "",
      "required_new_or_recipe_changed": true,
      "directory": "community"
    },
