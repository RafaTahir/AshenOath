{
  "scope": "Batch004 newly delivered exact runtime utterances only; full catalog remains incomplete",
  "lines": [
    {
      "source_id": "community:routine:hearthward:widow_elna:line",
      "speaker_id": "widow_elna",
      "canonical_speaker": "elna",
      "text": "Leave a place by the door for anyone who cannot sleep among strangers yet. They are still staying with us.",
      "text_sha256": "9a98726578a80f69ea418107e0ef2668c293718ca5e36a6f12b5b4bbd0f6613f",
      "cast_role": "elna",
      "direction": "everyday",
      "required_new_or_recipe_changed": true,
      "directory": "community"
    },
    {
      "source_id": "community:routine:hearthward:farmer_toma:line",
      "speaker_id": "farmer_toma",
      "canonical_speaker": "toma",
      "text": "The next meal will use what we kept dry today. That is a small promise, but it is one I can check with my own hands.",
      "text_sha256": "ad55dc432d549768916a041e10776ba61caa5bfb3d554a20ace46fd6526d3584",
      "cast_role": "toma",
      "direction": "everyday",
      "required_new_or_recipe_changed": true,
      "directory": "community"
    },
    {
      "source_id": "community:routine:hearthward:edric_campaign:line",
      "speaker_id": "edric_campaign",
      "canonical_speaker": "edric",
      "text": "I can account for the authority I used. I cannot lend you the consent of anyone who once answered to it. Put my answer beside the others, not above them.",
      "text_sha256": "73ad82a38c45ac98b97b6d69546ff30151913d1e61db1505634d55b51a513a19",
      "cast_role": "edric",
      "direction": "everyday",
      "required_new_or_recipe_changed": true,
      "directory": "community"
    },
    {
      "source_id": "community:routine:hearthward:captain_senn:line",
      "speaker_id": "captain_senn",
      "canonical_speaker": "senn",
      "text": "That bell is a warning, not a muster. If I answer it, I will come because I chose a watch. Keep my old rank off the board.",
      "text_sha256": "64013a26f75afbb901d3664fa069898b98251a8c7362f2cd4483aac453656ba4",
      "cast_role": "senn",
      "direction": "everyday",
      "required_new_or_recipe_changed": true,
      "directory": "community"
    },
    {
      "source_id": "community:aftermath:concord:shrine_pilgrim",
      "speaker_id": "shrine_pilgrim",
      "canonical_speaker": "anwen",
      "text": "The rota shows what is covered and what is vacant. We ask before we put a name in either place.",
      "text_sha256": "83b7be4da8ec4e3ed4c181801cf3f49981c549167c54777bc142db8b1be2f035",
      "cast_role": "sister_anwen",
      "direction": "everyday",
      "required_new_or_recipe_changed": true,
      "directory": "community"
    },
    {
      "source_id": "community:aftermath:concord:quality_mourner",
      "speaker_id": "quality_mourner",
      "canonical_speaker": "quality_mourner",
      "text": "The rota shows what is covered and what is vacant. We ask before we put a name in either place.",
      "text_sha256": "83b7be4da8ec4e3ed4c181801cf3f49981c549167c54777bc142db8b1be2f035",
      "cast_role": "quality_mourner",
      "direction": "everyday",
      "required_new_or_recipe_changed": true,
      "directory": "community"
    },
    {
      "source_id": "community:aftermath:open_road:shrine_pilgrim",
      "speaker_id": "shrine_pilgrim",
      "canonical_speaker": "anwen",
      "text": "The households reached Hearthward. There's no ward there, or here now. We have the copies; the rest of the Hart's memory is gone.",
      "text_sha256": "03759f51362ba2d0cc03d5f4d70c0df120f31dd14ea0520f6c073cc95910148c",
      "cast_role": "sister_anwen",
      "direction": "everyday",
      "required_new_or_recipe_changed": true,
      "directory": "community"
    },
    {
      "source_id": "community:aftermath:open_road:quality_mourner",
      "speaker_id": "quality_mourner",
      "canonical_speaker": "quality_mourner",
      "text": "The households reached Hearthward. There's no ward there, or here now. We have the copies; the rest of the Hart's memory is gone.",
      "text_sha256": "03759f51362ba2d0cc03d5f4d70c0df120f31dd14ea0520f6c073cc95910148c",
      "cast_role": "quality_mourner",
      "direction": "everyday",
      "required_new_or_recipe_changed": true,
      "directory": "community"
    },
    {
      "source_id": "community:participant:elna:hearthward",
      "speaker_id": "widow_elna",
      "canonical_speaker": "elna",
      "text": "Leave a place by the door for anyone who cannot sleep among strangers yet. They are still staying with us.",
      "text_sha256": "9a98726578a80f69ea418107e0ef2668c293718ca5e36a6f12b5b4bbd0f6613f",
      "cast_role": "elna",
      "direction": "",
      "required_new_or_recipe_changed": true,
      "directory": "community"
    },
    {
      "source_id": "community:participant:toma:hearthward",
      "speaker_id": "farmer_toma",
      "canonical_speaker": "toma",
      "text": "The next meal will use what we kept dry today. That is a small promise, but it is one I can check with my own hands.",
      "text_sha256": "ad55dc432d549768916a041e10776ba61caa5bfb3d554a20ace46fd6526d3584",
      "cast_role": "toma",
      "direction": "",
      "required_new_or_recipe_changed": true,
      "directory": "community"
    },
    {
      "source_id": "community:participant:edric:hearthward",
      "speaker_id": "edric_campaign",
      "canonical_speaker": "edric",
      "text": "I can account for the authority I used. I cannot lend you the consent of anyone who once answered to it. Put my answer beside the others, not above them.",
      "text_sha256": "73ad82a38c45ac98b97b6d69546ff30151913d1e61db1505634d55b51a513a19",
      "cast_role": "edric",
      "direction": "",
      "required_new_or_recipe_changed": true,
      "directory": "community"
    },
    {
      "source_id": "community:participant:senn:hearthward",
      "speaker_id": "captain_senn",
      "canonical_speaker": "senn",
      "text": "That bell is a warning, not a muster. If I answer it, I will come because I chose a watch. Keep my old rank off the board.",
      "text_sha256": "64013a26f75afbb901d3664fa069898b98251a8c7362f2cd4483aac453656ba4",
      "cast_role": "senn",
      "direction": "",
      "required_new_or_recipe_changed": true,
      "directory": "community"
    },
    {
      "source_id": "community:consent:anwen:yes",
      "speaker_id": "sister_anwen",
      "canonical_speaker": "anwen",
      "text": "I can take the dawn round. If I cannot keep it, I will tell the next keeper. That is what I am offering.",
      "text_sha256": "54efa42edbdcbcdf9b685adb629c0e27da35eb2b5c65cac50468bf9202546859",
      "cast_role": "sister_anwen",
      "direction": "",
      "required_new_or_recipe_changed": true,
      "directory": "community"
    },
    {
      "source_id": "community:consent:anwen:no",
      "speaker_id": "sister_anwen",
      "canonical_speaker": "anwen",
      "text": "Not another promise today. The beds are still open; my answer need not close them.",
      "text_sha256": "b2209e038f6a7274d759d6c93f3c56465960621276ef91183fa91ad666df6dd7",
      "cast_role": "sister_anwen",
      "direction": "",
      "required_new_or_recipe_changed": true,
      "directory": "community"
    },
    {
      "source_id": "community:consent:anwen:withdraw",
      "speaker_id": "sister_anwen",
      "canonical_speaker": "anwen",
      "text": "I need to leave the dawn round. Put my place back on the board, without putting another name in it.",
      "text_sha256": "372d4207ad723c48f7a206a1da17ff73860f63de846214ca996424445989dffd",
      "cast_role": "sister_anwen",
      "direction": "",
      "required_new_or_recipe_changed": true,
      "directory": "community"
    },
    {
      "source_id": "community:consent:anwen:question",
      "speaker_id": "player",
      "canonical_speaker": "kael",
      "text": "Will you take a care shift, with the right to step away?",
      "text_sha256": "28180a24694fcb2bfcf499ad3b9734c9814708b9f1d862785db72ea5dabd8d15",
      "cast_role": "player",
      "direction": "",
      "required_new_or_recipe_changed": true,
      "directory": "community"
    },
    {
      "source_id": "community:consent:mira:yes",
      "speaker_id": "mira",
      "canonical_speaker": "mira",
      "text": "I will take the evening round, and teach someone willing to cover it. No one learns by being volunteered.",
      "text_sha256": "409eb26f4571bfa653d76343037c3c61a27dc38f7d7dbdd11325d847bb746d3c",
      "cast_role": "mira",
      "direction": "",
      "required_new_or_recipe_changed": true,
      "directory": "community"
    },
    {
      "source_id": "community:consent:mira:no",
      "speaker_id": "mira",
      "canonical_speaker": "mira",
      "text": "I can help with this room. I cannot promise a standing shift.",
      "text_sha256": "19fc249410a94e5ea8e0e789bc856d9f4fbc8b4f9fbc7f076146483f7f26d33e",
      "cast_role": "mira",
      "direction": "",
      "required_new_or_recipe_changed": true,
      "directory": "community"
    },
    {
      "source_id": "community:consent:mira:withdraw",
      "speaker_id": "mira",
      "canonical_speaker": "mira",
      "text": "I cannot carry the evening round now. The medicines and instructions stay here.",
      "text_sha256": "4aeb5300a5f06da80b766d6dc1b8dc976021a571cb14c93c074e154c588b11d0",
      "cast_role": "mira",
      "direction": "",
      "required_new_or_recipe_changed": true,
      "directory": "community"
    },
    {
      "source_id": "community:consent:mira:question",
      "speaker_id": "player",
      "canonical_speaker": "kael",
      "text": "Would you choose to share the care work?",
      "text_sha256": "b74b0a933874a6d7638993ce2c642466b24d5c8fab1c4a50a625c04f62c3d539",
      "cast_role": "player",
      "direction": "",
      "required_new_or_recipe_changed": true,
      "directory": "community"
    },
    {
      "source_id": "community:consent:nera:yes",
      "speaker_id": "saga_nera",
      "canonical_speaker": "nera",
      "text": "One crossing round in the morning. Weather can stop it, and I can leave it. Write both beside my name.",
      "text_sha256": "25f4596d091c800bce87dabd7b702892b39964d204616269d3dafabc3a8747da",
      "cast_role": "nera",
      "direction": "",
      "required_new_or_recipe_changed": true,
      "directory": "community"
    },
    {
      "source_id": "community:consent:nera:no",
      "speaker_id": "saga_nera",
      "canonical_speaker": "nera",
      "text": "I can explain the route. I am not agreeing to keep it every day.",
      "text_sha256": "86f9e9f19815d34ac9cd4f6a7ccc44677fc68e7f130092920cb3683ae597990e",
      "cast_role": "nera",
      "direction": "",
      "required_new_or_recipe_changed": true,
      "directory": "community"
    },
    {
      "source_id": "community:consent:nera:withdraw",
      "speaker_id": "saga_nera",
      "canonical_speaker": "nera",
      "text": "Take me off the crossing rota. Leave the route marks for whoever comes next.",
      "text_sha256": "992ad992ed3ba165a1b2a33f5bd47fdf9a2b528bd2d3cd41b6e99d15440e9c9f",
      "cast_role": "nera",
      "direction": "",
      "required_new_or_recipe_changed": true,
      "directory": "community"
    },
    {
      "source_id": "community:consent:nera:question",
      "speaker_id": "player",
      "canonical_speaker": "kael",
      "text": "Will you keep a route shift under these terms?",
      "text_sha256": "4e3181dcc0589317da6ed72d19b5621814894763c79aad04682db5eeb13bf239",
      "cast_role": "player",
      "direction": "",
      "required_new_or_recipe_changed": true,
      "directory": "community"
    },
    {
      "source_id": "community:consent:nessa:yes",
      "speaker_id": "saga_nessa",
      "canonical_speaker": "nessa",
      "text": "I will keep the kitchen's count for now. If I stop, the bowls do not stop with me.",
      "text_sha256": "bd4e863f651488cc24627a2fba43040e37063d644b710bab17ab6b2ceb3993c5",
      "cast_role": "nessa",
      "direction": "",
      "required_new_or_recipe_changed": true,
      "directory": "community"
    },
    {
      "source_id": "community:consent:nessa:no",
      "speaker_id": "saga_nessa",
      "canonical_speaker": "nessa",
      "text": "I have already promised today's meal. That is all I can give you now.",
      "text_sha256": "a40c364a08e9b939a9cecac8417c6bd79cc37caf66fde1823ab48e9c23078338",
      "cast_role": "nessa",
      "direction": "",
      "required_new_or_recipe_changed": true,
      "directory": "community"
    },
    {
      "source_id": "community:consent:nessa:withdraw",
      "speaker_id": "saga_nessa",
      "canonical_speaker": "nessa",
      "text": "Someone else must keep the count after today. Nobody loses their share because I am tired.",
      "text_sha256": "6b7998d8789c832a6f0341c83591dd130c37ae56e04245fd76185360800ecccb",
      "cast_role": "nessa",
      "direction": "",
      "required_new_or_recipe_changed": true,
      "directory": "community"
    },
    {
      "source_id": "community:consent:nessa:question",
      "speaker_id": "player",
      "canonical_speaker": "kael",
      "text": "Would you take a share of the food and delivery rota?",
      "text_sha256": "1e6226c3b21e79f35cbba04e8b8f735613a4c6e0e2f3b322aace6ac41337e2f7",
      "cast_role": "player",
      "direction": "",
      "required_new_or_recipe_changed": true,
      "directory": "community"
    },
    {
      "source_id": "community:consent:vale:yes",
      "speaker_id": "vargan_record_keeper",
      "canonical_speaker": "vale",
      "text": "I will check one public copy and protect what was entrusted to me. A record is evidence. It is never somebody's consent.",
      "text_sha256": "3b21035a543345ec8d6584e5c9a742bc64c800d0004df355474fdcf23f92c384",
      "cast_role": "vale",
      "direction": "",
      "required_new_or_recipe_changed": true,
      "directory": "community"
    }
  ]
}
