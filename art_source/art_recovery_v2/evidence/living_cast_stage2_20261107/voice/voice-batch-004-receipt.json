{
  "scope": "Batch004 newly delivered exact runtime utterances only; full catalog remains incomplete",
  "synthesized": 25,
  "retained": 468,
  "pending": 347,
  "new_bytes_this_batch": 976504,
  "new_voice_bytes_total": 3035960,
